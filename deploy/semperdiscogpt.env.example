# Example environment file. Copy to /etc/semperdiscogpt.env, fill in, then:
#   chown root:root /etc/semperdiscogpt.env && chmod 600 /etc/semperdiscogpt.env
# Never commit the real file.

# Login password, 12 characters or more.
RAGUI_PASSWORD=change-me-to-a-long-password

# Optional: your own SearXNG instance, for web search.
#RAGUI_SEARXNG=http://192.168.1.50:8888

# Optional: a second model server (see extras/cve-gpt).
#RAGUI_LAB=http://127.0.0.1:11500

# Makes Python print startup lines to the journal straight away.
PYTHONUNBUFFERED=1
